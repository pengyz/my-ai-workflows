#!/bin/bash
#
# pre-commit hook: 验证修改的 skill 文件
#
# 安装方式：
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# 跳过验证：
#   git commit --no-verify
#

set -e

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 获取修改的 skill 文件
changed_skills=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'skills/.*/SKILL\.md$' || true)

# 如果没有修改 skill 文件，直接通过
if [ -z "$changed_skills" ]; then
    exit 0
fi

echo -e "${YELLOW}🔍 验证修改的 skill 文件...${NC}"
echo "修改的文件:"
echo "$changed_skills" | sed 's/^/  - /'
echo ""

# 运行验证脚本
if python3 scripts/verify-skills.py --changed-only 2>&1; then
    echo -e "${GREEN}✅ Skill 验证通过${NC}"
    exit 0
else
    echo -e "${RED}❌ Skill 验证失败${NC}"
    echo ""
    echo -e "${YELLOW}提示：使用 --no-verify 跳过验证${NC}"
    echo "  git commit --no-verify"
    exit 1
fi
